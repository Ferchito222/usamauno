/* Checkbox Radio button style */
$color--white = #FFFFFF
$color--light-grey = #E6E6E6
$color--grey = #CCCCCC
$color--dark-grey = #7B7B7B
$color--primary = #2AA1C0
$color--secondary = #009688

.Control
  display block
  position relative
  padding-left 30px
  width max-content
  margin 0 auto 15px
  cursor pointer
  font-size 18px
  
  // Hide default browser input
  input
    position absolute
    z-index -1
    opacity 0

.Control-indicator
  position absolute
  top -2px
  left 0
  height 20px
  width 20px
  background $color--light-grey
  
  .Control-radio &
    border-radius 50% // Makes radio buttons circlular
  
  // Hover and focus
  .Control:hover input ~ &,
  .Control input:focus ~ &
    background $color--grey
  
  // Checked
  .Control input:checked ~ &
    background $color--primary

  // Hover when checked
  .Control:hover input:not([disabled]):checked ~ &,
  .Control input:checked:focus ~ &
    background $color--secondary
  
  // Hide default browser input
  .Control input:disabled ~ &
    background $color--light-grey
    opacity 0.6
    pointer-events none

  &:after
    content ''
    position absolute
    display none // Hide check

    .Control input:checked ~ &
      display block // Show check

    // Checkbox tick
    .Control-checkbox &
      left 8px
      top 4px
      width 3px
      height 8px
      border solid $color--white
      border-width 0 2px 2px 0
      transform rotate(45deg)
    
    // Disabled tick colour
    .Control-checkbox input:disabled ~ &
      border-color $color--dark-grey

    // Radio button inner circle
    .Control-radio &
      left 7px
      top 7px
      height 6px
      width 6px
      border-radius 50%
      background $color--white

    // Disabled circle colour
    .Control-radio input:disabled ~ &
      background $color--dark-grey

/* File */
.Input-file
  width 0.1px
  height 0.1px
  opacity 0
  overflow hidden
  position absolute
  z-index -1

.Input-file
  & + label
    max-width 80%
    font-weight 700
    text-overflow ellipsis
    white-space nowrap
    cursor pointer
    display inline-block
    overflow hidden
    padding .625rem 1.25rem
    *
    svg
      width 1em
      height 1em
      vertical-align middle
      margin-top -0.25em
      margin-right 0.25em

.Input-file:focus + label,
.Input-file.has-focus + label
  outline 1px dotted #000
  outline -webkit-focus-ring-color auto 5px

.Input-file1
  & + label
    color #939393
    figure
      width 60px
      height 60px
      border-radius 50%
      background-color #67acdb
      display block
      padding 20px
      margin 0 auto 10px
    svg
      width 100%
      height 100%
      fill #f1e5e6

.Input-file1:focus + label,
.Input-file1.has-focus + label,
.Input-file1 + label:hover
  color #939393

.Input-file1:focus + label figure,
.Input-file1.has-focus + label figure,
.Input-file1 + label:hover figure
  background-color #419cd8

/* V-Select */
.v-select,
.v-select
  & .dropdown-toggle,
  & .dropdown-menu
    color #606970 !important
    font-size .74rem
  & input[type=search]
    height 30px !important
  & .open-indicator
    bottom 4px !important
  & .dropdown-toggle
    background-color white !important
  & .selected-tag
    line-height 20px !important

/* Lists */
$lists--enabled = #138496
$lists--disabled = #ef9a9a

.Lists
  width max-content
  min-width 330px
  margin 0 auto
  ol
    counter-reset li
    list-style none
    *list-style decimal
    font-size .7rem
    padding 0
    // margin-bottom 4em
    ol
      margin 0 0 0 2em
  a
    position relative
    display block
    padding .4em 1.5em .4em 2em
    *padding .4em
    margin .5em 0
    background $lists--enabled
    color #ffffff
    text-decoration none
    -moz-border-radius .3em
    -webkit-border-radius .3em
    border-radius 10em
    transition all .2s ease-in-out
    &:hover
      background $lists--disabled
      text-decoration none
      transform scale(1.05)
    &:before
      content counter(li)
      counter-increment li
      position absolute
      left -1.3em
      top 50%
      margin-top -1.3em
      background $lists--enabled
      height 2em
      width 2em
      line-height 2em
      border .3em solid #fff
      text-align center
      font-weight bold
      -moz-border-radius 2em
      -webkit-border-radius 2em
      border-radius 2em
      color #FFF
    &.List-disabled
      background $lists--disabled

.Text-center
  text-align center

.Text-right
  text-align right

/* Card */
.Card
  width 99.5%
  margin .3em auto
  display flex
  flex-direction column
  background #ffffff
  border 1px solid rgba(0,0,0,.125)
  border-radius .25rem
  boxSizing()
  .Card-header
    padding .75rem 1.25rem
    background-color rgba(0,0,0,0.01);
    border-bottom 1px solid rgba(0,0,0,0.125)
    .vue-js-switch .v-switch-label
      font-size .9rem !important
  .Card-body
    flex 1 1 auto
    padding .4em
    .vue-js-switch .v-switch-label
      font-size .8rem !important
    .Btn-xs
      line-height normal

/* Pagination */
.Pagination
  width 50%
  margin: 1rem auto
  text-align center

.Pagination .Pagination-counter
  display inline-block
  width 140px
  font-weight 600
  font-size 1.4rem
  color #546E7A

.Pagination .Pagination-button
  display inline-block
  width 80px
  height 40px
  background-color #78909C
  border .1rem solid #90A4AE
  border-radius .2rem
  color white
  font-size .9rem
  line-height 40px
  text-decoration none
  &:hover
    background-color #546E7A

// colors
$color-1 = #2E4057; // Pickled Bluewood
$color-2 = #64a281; // Aqua Forest
$color-3 = #ffffff; // White
// fonts 
$primary-font = 'PT Sans', sans-serif;

nav[role=navigation]
  text-align center

.cd-pagination
  width 90%
  max-width 768px
  margin 2em auto
  text-align center
  li
    display none
    margin 0 .2em
    background-color #ffffff
    &.button
      display inline-block
  a
    border 1px solid #e6e6e6
    border-radius .25em
    font-family $primary-font
    color $color-1
    text-decoration none
    &:active
      -webkit-transform scale(.9)
      -moz-transform scale(.9)
      -ms-transform scale(.9)
      -o-transform scale(.9)
      transform scale(.9)
    &.disabled
      color rgba(46, 64, 87, 0.4)
      pointer-events none
  .button
    &:first-of-type
      a
        &::before
          content '\00ab  '
    &:last-of-type
      a
        &::after
            content ' \00bb'
  .current
    background-color #64a281
    border-color #64a281
    color #fff
    pointer-events none

.cd-pagination a,
.cd-pagination span
  display inline-block
  -webkit-user-select none
  -moz-user-select none
  -ms-user-select none
  user-select none
  padding .6em .8em
  font-size .8rem

.no-touch
  .cd-pagination
    a
      &:hover
        background-color #f2f2f2

.cd-pagination a.disabled::before,
.cd-pagination a.disabled::after
  opacity .4

@media only screen and (min-width:768px)
  .cd-pagination
    li
      display inline-block

@media only screen and (min-width:1170px)
  .cd-pagination
    margin 1em auto